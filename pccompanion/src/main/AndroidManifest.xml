<?xml version="1.0" encoding="utf-8"?>
<!-- DSF PC Companion: the one screen is :dsforever's PcCompanionActivity (its launcher entry comes from that module's manifest) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the companion keeps its logs and downloaded data under /sdcard/WowCompanion, as DS Forever does -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- the game kit's big files come from DS Forever Desktop's bridge over the home network's plain HTTP, as its WebSocket does -->
    <application
        android:label="DSF PC Companion"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
</manifest>
