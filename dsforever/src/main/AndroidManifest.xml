<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Streaming (S2): the PC on the LAN (normal permissions, no prompt; the launcher already holds them) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Companion-only mode opens the top screen's streamer (Artemis, else Moonlight): Android 11+ hides other apps unless named -->
    <queries>
        <package android:name="com.limelight.noir" />
        <package android:name="com.limelight" />
        <package android:name="com.limelight.debug" />
    </queries>
    <application>
        <!-- Streaming mode (S2): WoW on the PC through Moonlight's core, on the top screen; the companion stays on the bottom -->
        <activity
            android:name="com.jrees.wowcompanion.stream.StreamActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />
        <!-- Companion-only mode (PcCompanionActivity.kt): its own home-screen icon; the companion on the bottom screen, fed by DS Forever
             Desktop's bridge, while another streamer (Apollo + Artemis) shows WoW on the top one. Its own task, so it lives beside both -->
        <activity
            android:name="com.jrees.wowcompanion.stream.PcCompanionActivity"
            android:exported="true"
            android:label="DSF PC Companion"
            android:taskAffinity="app.dsforever.pccompanion"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Companion-only mode: the Bluetooth keyboard's keys to WoW on the PC while the streamer is in front (KeyboardBridgeService.kt) -->
        <service
            android:name="com.jrees.wowcompanion.stream.KeyboardBridgeService"
            android:exported="true"
            android:label="@string/dsf_keyboard_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/dsf_keyboard_service" />
        </service>
        <!-- Settings > Frame generation: picks the player's own Lossless.dll (FrameGenPickActivity.kt) -->
        <activity
            android:name="com.jrees.wowcompanion.FrameGenPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The safe close before an install (SafeCloseReceiver.kt): the game's own Exit Game, so it writes its saved state. DUMP is held by
             the system and the adb shell, never by a normal app: only an install step (adb) can ask it -->
        <receiver
            android:name="com.jrees.wowcompanion.SafeCloseReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.dsforever.SAFE_CLOSE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
